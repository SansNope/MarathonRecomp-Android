+        std::vector<int8_t> remapped(interfaceSpirv[3], -1);
+        int8_t nextLocation = 0;
+        for (uint32_t location = 0; location < varyings.size(); location++) {
+            const uint32_t id = varyings[location].id;
+            if (id != 0) {
+                if ((mask & (uint32_t(1) << location)) != 0) {
+                    remapped[id] = nextLocation++;
+                }
+                else {
+                    removed[id] = true;
+                }
+            }
+        }
+
+        const auto isRemoved = [&](uint32_t id) { return id < removed.size() && removed[id]; };
+        std::vector<uint32_t> result;
+        result.reserve(interfaceSpirv.size());
+        result.insert(result.end(), interfaceSpirv.begin(), interfaceSpirv.begin() + 5);
+        for (size_t offset = 5; offset < interfaceSpirv.size();) {
+            const auto *op = interfaceSpirv.data() + offset;
+            const uint32_t length = op[0] >> 16;
+            const uint32_t opcode = op[0] & 0xFFFF;
