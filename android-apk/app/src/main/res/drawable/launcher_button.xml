<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary launcher button (matches MarathonLauncherActivity.button()); from UnleashedRecomp-Android. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#405CC8FF">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#E6173466" android:endColor="#E60A1A3C" />
            <stroke android:width="1dp" android:color="#5F8FD0" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</ripple>
