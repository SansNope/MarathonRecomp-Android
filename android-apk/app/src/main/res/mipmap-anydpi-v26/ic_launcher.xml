<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon. The artwork is the full-bleed background layer (108dp, image at
     90dp in the centre with extended edges, so a launcher mask shows ~80% of it); see
     icon-source/CREDITS.md for its origin. The legacy mipmap-*/ic_launcher.png use the same art. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
